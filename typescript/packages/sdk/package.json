{
  "name": "@cred-protocol/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for the Cred Protocol trust evaluation API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cred-protocol",
    "trust",
    "web3",
    "reputation",
    "credit-scoring"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/credprotocol/cred-sdk.git",
    "directory": "typescript/packages/sdk"
  },
  "homepage": "https://docs.credprotocol.com/sdks/typescript",
  "devDependencies": {
    "@x402/core": "2.29.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
