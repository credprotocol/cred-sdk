{
  "name": "@cred-protocol/nextjs",
  "version": "0.2.0",
  "description": "Next.js middleware for Cred Protocol trust-gated APIs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["cred-protocol", "nextjs", "middleware", "trust", "web3"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/credprotocol/cred-sdk.git",
    "directory": "typescript/packages/nextjs"
  },
  "homepage": "https://docs.credprotocol.com/sdks/nextjs",
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "dependencies": {
    "@cred-protocol/sdk": "workspace:*"
  },
  "devDependencies": {
    "next": "^16.4.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
